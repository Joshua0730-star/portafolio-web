---
import ProjectCard from "./projects/ProjectCard.astro";
import { getFeaturedProjects } from "../lib/projects";
import { useTranslations } from "../i18n/ui";
import { localePath, DEFAULT_LOCALE } from "../i18n/config";
import type { Locale } from "../i18n/config";

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(locale);
const featured = await getFeaturedProjects(locale, 4);
---

<section id="projects" class="py-20 px-4 bg-muted/30">
  <div class="container mx-auto max-w-6xl">
    <header class="text-center mb-12">
      <p class="text-sm font-mono text-primary mb-2">{t("home.featuredKicker")}</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-3">
        {t("home.featuredTitle")}
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        {t("home.featuredSubtitle")}
      </p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 max-w-4xl mx-auto">
      {featured.map((p, i) => <ProjectCard project={p} priority={i < 2} />)}
    </div>

    <div class="text-center mt-12">
      <a
        href={localePath("/projects", locale)}
        class="inline-flex items-center gap-2 rounded-md border border-border bg-background px-5 py-2.5 text-sm font-medium hover:bg-accent/30 hover:border-primary/40 transition-all"
      >
        {t("common.viewAll")}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
