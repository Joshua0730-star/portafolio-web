---
interface Props {
  name: string;
  role: string;
  description: string;
  category: "editor" | "agent" | "model" | "method";
}
const { name, role, description, category } = Astro.props;
const tone = {
  editor: "from-sky-500/10 to-sky-500/0 ring-sky-500/20",
  agent: "from-violet-500/10 to-violet-500/0 ring-violet-500/20",
  model: "from-emerald-500/10 to-emerald-500/0 ring-emerald-500/20",
  method: "from-amber-500/10 to-amber-500/0 ring-amber-500/20",
}[category];
---

<article
  class={`group rounded-xl border border-border bg-gradient-to-br ${tone} p-5 ring-1 transition-all hover:-translate-y-0.5 hover:border-primary/40`}
>
  <div class="flex items-baseline justify-between gap-2 mb-1">
    <h3 class="text-base font-semibold">{name}</h3>
    <span
      class="text-[10px] uppercase tracking-wider text-muted-foreground font-mono"
      >{category}</span
    >
  </div>
  <p class="text-xs text-primary/80 font-medium mb-2">{role}</p>
  <p class="text-sm text-muted-foreground leading-relaxed">{description}</p>
</article>
