---
interface Image {
  src: string;
  alt: string;
  caption?: string;
}
interface Props {
  images: Image[];
  startIndex?: number;
}
const { images, startIndex = 0 } = Astro.props;
const list = images.slice(startIndex);
---

{
  list.length > 0 && (
    <section aria-label="Project gallery" class="not-prose my-10">
      <ul role="list" class="grid gap-6 sm:grid-cols-2">
        {list.map((img) => (
          <li role="listitem" class="space-y-2">
            <figure class="overflow-hidden rounded-lg border border-border bg-card">
              <img
                src={img.src}
                alt={img.alt}
                loading="lazy"
                width="800"
                height="450"
                class="w-full aspect-video object-cover"
              />
              {img.caption && (
                <figcaption class="px-3 py-2 text-xs text-muted-foreground bg-muted/40">
                  {img.caption}
                </figcaption>
              )}
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )
}
