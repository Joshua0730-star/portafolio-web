---
import { useTranslations } from "../i18n/ui";
import { DEFAULT_LOCALE } from "../i18n/config";
import type { Locale } from "../i18n/config";

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(locale);

const experience = [
  {
    title: t("experience.role.junior"),
    company: t("experience.company.drugstore"),
    location: t("experience.location.remote"),
    period: t("experience.period.drugstore"),
    description: t("experience.description.drugstore"),
    achievements: [
      t("experience.achievement.perf"),
      t("experience.achievement.components"),
      t("experience.achievement.review"),
    ],
  },
];
---

<section
  id="experience"
  class="py-20 bg-muted/30 mx-auto flex flex-col justify-center"
>
  <div class="container mx-auto max-w-4xl px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-foreground">
        {t("experience.title")}
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        {t("experience.subtitle")}
      </p>
    </div>

    <div class="space-y-6">
      {experience.map(({title, company, location, period, description, achievements}) => (
      <div
        class="border-border border-2 bg-card hover:shadow-lg transition-shadow rounded-lg overflow-hidden md:max-w-xl mx-auto"
      >
        <div class="p-6">
          <div
            class="flex flex-col md:flex-row md:items-center md:justify-between gap-2"
          >
            <div>
              <h3 class="text-xl font-semibold text-card-foreground">
                {title}
              </h3>
              <p class="text-primary font-medium">{company}</p>
            </div>
            <div
              class="flex flex-col md:items-end gap-1 text-sm text-muted-foreground"
            >
              <div class="flex items-center gap-1.5">
                <!-- Calendar Icon -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3 w-3"
                  ><path d="M8 2v4"></path><path d="M16 2v4"></path><rect
                    width="18"
                    height="18"
                    x="3"
                    y="4"
                    rx="2"></rect><path d="M3 10h18"></path></svg
                >
                {period}
              </div>
              <div class="flex items-center gap-1.5">
                <!-- MapPin Icon -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3 w-3"
                  ><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                  ></path><circle cx="12" cy="10" r="3"></circle></svg
                >
                {location}
              </div>
            </div>
          </div>
        </div>
        <div class="px-6 pb-6 space-y-4">
          <p class="text-muted-foreground">{description}</p>
          <div>
            <h4 class="font-medium mb-2 text-card-foreground">
              {t("experience.achievements")}
            </h4>
            <ul class="space-y-1">
              {
                achievements ? achievements.map((achievement) => (
                  <li class="flex items-start gap-2 text-sm text-muted-foreground">
                    <span class="text-primary mt-1">•</span>
                    {achievement}
                  </li>
                )): []
              }
            </ul>
          </div>
        </div>
      </div>
      ))}
    </div>
  </div>
</section>
