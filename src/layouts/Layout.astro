---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  type?: "website" | "article" | "profile";
  noindex?: boolean;
  keywords?: string[];
  lang?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const props = Astro.props;
---

<BaseLayout {...props}><slot /></BaseLayout>
