---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
import ProjectGallery from "../../../components/projects/ProjectGallery.astro";
import {
  getAllProjects,
  getAdjacentProjects,
  canonicalSlug,
} from "../../../lib/projects";
import { useTranslations } from "../../../i18n/ui";

const t = useTranslations("en");

export async function getStaticPaths() {
  // Build a page for every canonical slug; the localizer in lib/projects picks
  // the EN variant when present and falls back to ES otherwise.
  const all = await getAllProjects("en");
  return all.map((project) => ({
    params: { slug: canonicalSlug(project.slug) },
    props: { project },
  }));
}

const { project } = Astro.props;
const isFallback = (project.data.lang ?? "es") !== "en";
const { Content } = await project.render();
const { prev, next } = await getAdjacentProjects(project.slug, "en");
---

<ProjectLayout project={project} prev={prev} next={next}>
  {
    isFallback && (
      <aside
        role="note"
        class="not-prose mb-8 flex items-start gap-3 rounded-lg border border-primary/20 bg-primary/5 px-4 py-3 text-sm text-foreground/80"
      >
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mt-0.5 h-4 w-4 shrink-0 text-primary"
        >
          <circle cx="12" cy="12" r="10" />
          <path d="M12 16v-4" />
          <path d="M12 8h.01" />
        </svg>
        <span>{t("fallback.translationPending")}</span>
      </aside>
    )
  }
  <Content />
  {
    project.data.gallery && project.data.gallery.length > 2 && (
      <ProjectGallery images={project.data.gallery} startIndex={2} />
    )
  }
</ProjectLayout>
